# Публичные значения сборки Vite. Это не service_role.
# Их задают в Vercel → Settings → Environment Variables и пересобирают проект.
# В чат эти значения присылать не нужно.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Только сервер Vercel, без префикса VITE_. В браузер и в чат этот ключ не попадает.
OPENAI_API_KEY=
# Необязательно. Если пусто, сервер вызывает gpt-4o-mini.
# OPENAI_MODEL=
